# Dependencies (this project is zero-dependency today; kept covered anyway)
node_modules/

# NOTE: index.html and assets/css/styles.css are generated by `npm run build`,
# but they are committed deliberately so the finished page can be opened or
# deployed straight from a fresh clone without running a build first. They are
# still reproducible: `npm run build` regenerates them byte-identically.

# Credentials / local environment — never commit
.env
.env.*
*.pem
*.key
*.p12
*.pfx

# Visual-QA output. Regenerated by `npm run qa`; never part of the published
# site. (The QA iframe harness is served in-memory, so there is no scratch file.)
qa/out/

# Production output. Regenerated by `npm run build` on Vercel; committing it
# would only risk shipping a stale copy of the built site.
dist/

# Local logs and OS/editor noise only
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini